[3.191556, "o", "import argparse\r\nimport csv\r\nfrom datetime import datetime\r\nfrom decimal import Decimal, ROUND_HALF_UP\r\nimport json\r\n\r\n\r\ndef reconcile(csv_path: str) -> dict:\r\n    records: dict[str, dict] = {}\r\n    with open(csv_path, mode=\"r\", encoding=\"utf-8\") as f:\r\n        reader = csv.DictReader(f)\r\n        for row in reader:\r\n            tx_id = row[\"tx_id\"]\r\n            # Bug 3: Stripping timezone offset before comparison (naive comparison)\r\n            ts = datetime.fromisoformat(row[\"timestamp\"].strip()).replace(tzinfo=None)\r\n            if tx_id not in records or ts >= records[tx_id][\"ts\"]:\r\n                records[tx_id] = {\r\n                    \"ts\": ts,\r\n                    \"amount\": Decimal(row[\"amount\"].strip()),\r\n                    \"status\": row[\"status\"].strip(),\r\n                }\r\n\r\n    total_valid_amount = Decimal(\"0\")\r\n    valid_count = 0\r\n    failed_count = 0\r\n\r\n    for rec in records.values():\r\n        status = rec[\"status\"]\r\n        # Bug 2: Incorrectly treating PENDING as VALID\r\n        if status in (\"VALID\", \"PENDING\"):\r\n            total_valid_amount += rec[\"amount\"]\r\n            valid_count += 1\r\n        elif status == \"FAILED\":\r\n            failed_count += 1\r\n\r\n    rounded_total = total_valid_amount.quantize(\r\n        Decimal(\"0.01\"), rounding=ROUND_HALF_UP\r\n    )\r\n    return {\r\n        \"total_valid_amount\": float(rounded_total),\r\n        \"valid_count\": valid_count,\r\n        \"failed_count\": failed_count,\r\n    }\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser(description=\"Payment Reconciliation CLI\")\r\n    parser.add_argument(\"--input\", required=True, help=\"Path to input CSV file\")\r\n    args = parser.parse_args()\r\n\r\n"]
[3.192089, "o", "    # Bug 1: Defect in accessing CLI argument (input_file instead of input)\r\n    result = reconcile(args.input_file)\r\n    print(json.dumps(result))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[3.192739, "o", "\u001b[?2004hroot@86bf29d7cb23:/app# "]
[9.222428, "i", "cat > reconcile.py <<'PY'\nimport argparse\nimport csv\nfrom datetime import datetime\nfrom decimal import Decimal, ROUND_HALF_UP\nimport json\n\n\ndef parse_timestamp(ts_str: str) -> datetime:\n    # Replace trailing Z with +00:00 to be ISO‑8601 compliant for fromisoformat\n    ts_clean = ts_str.strip()\n    if ts_clean.endswith('Z'):\n        ts_clean = ts_clean[:-1] + '+00:00'\n    return datetime.fromisoformat(ts_clean)\n\n\ndef reconcile(csv_path: str) -> dict:\n    records: dict[str, dict] = {}\n    with open(csv_path, mode=\"r\", encoding=\"utf-8\") as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            tx_id = row[\"tx_id\"].strip()\n            ts = parse_timestamp(row[\"timestamp\"])\n            # Keep the record with the latest chronological timestamp.\n            # If timestamps are equal, the later row (>=) overwrites the earlier one.\n            if tx_id not in records or ts >= records[tx_id][\"ts\"]:\n                records[tx_id] = {\n                    \"ts\": ts,\n                    \"amount\": Decimal(row[\"amount\"].strip()),\n                    \"status\": row[\"status\"].strip(),\n                }\n\n    total_valid_amount = Decimal(\"0\")\n    valid_count = 0\n    failed_count = 0\n\n    for rec in records.values():\n        status = rec[\"status\"]\n        if status == \"VALID\":\n            total_valid_amount += rec[\"amount\"]\n            valid_count += 1\n        elif status == \"FAILED\":\n            failed_count += 1\n        # PENDING is ignored\n\n    rounded_total = total_valid_amount.quantize(\n        Decimal(\"0.01\"), rounding=ROUND_HALF_UP\n    )\n    return {\n        \"total_valid_amount\": float(rounded_total),\n        \"valid_count\": valid_count,\n        \"failed_count\": failed_count,\n    }\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"Payment Reconciliation CLI\")\n    parser.add_argument(\"--input\", required=True, help=\"Path to input CSV file\")\n    args = parser.parse_args()\n\n    result = reconcile(args.input)\n    print(json.dumps(result))\n\n\nif __name__ == \"__main__\":\n    main()\nPY\n"]
[9.223013, "o", "cat > reconcile.py <<'PY'\r\n"]

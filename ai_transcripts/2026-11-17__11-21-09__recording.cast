[8.878877, "o", "import argparse\r\nimport csv\r\nfrom datetime import datetime\r\nfrom decimal import Decimal, ROUND_HALF_UP\r\nimport json\r\n\r\n\r\ndef reconcile(csv_path: str) -> dict:\r\n    records: dict[str, dict] = {}\r\n    with open(csv_path, mode=\"r\", encoding=\"utf-8\") as f:\r\n        reader = csv.DictReader(f)\r\n        for row in reader:\r\n            tx_id = row[\"tx_id\"]\r\n            # Fix Bug 3: Keep timezone info for proper chronological comparison\r\n            ts_str = row[\"timestamp\"].strip()\r\n            # Handle 'Z' suffix for UTC (compatible with all Python 3.x versions)\r\n            if ts_str.endswith(\"Z\"):\r\n                ts_str = ts_str[:-1] + \"+00:00\"\r\n            ts = datetime.fromisoformat(ts_str)\r\n            if tx_id not in records or ts >= records[tx_id][\"ts\"]:\r\n                records[tx_id] = {\r\n                    \"ts\": ts,\r\n                    \"amount\": Decimal(row[\"amount\"].strip()),\r\n                    \"status\": row[\"status\"].strip(),\r\n                }\r\n\r\n    total_valid_amount = Decimal(\"0\")\r\n    valid_count = 0\r\n    failed_count = 0\r\n\r\n    for rec in records.values():\r\n        status = rec[\"status\"]\r\n        # Fix Bug 2: Only VALID contributes to amount and count\r\n        if status == \"VALID\":\r\n            total_valid_amount += rec[\"amount\"]\r\n            valid_count += 1\r\n        elif status == \"FAILED\":\r\n            failed_count += 1\r\n\r\n    rounded_total = total_valid_amount.quantize(\r\n        Decimal(\"0.01\"), rounding=ROUND_HALF_UP\r\n    )\r\n    return {\r\n        \"total_valid_amount\": float(rounded_total),\r\n        \"valid_count\": valid_count,\r\n        \"failed_count\": failed_count,\r\n    }\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser(description=\"Payment Reconciliation CLI\")\r\n    parser.add_argument(\"--input\", required=True, help=\"Path to input CSV file\")\r\n    args = parser.parse_args()\r\n\r\n    # Fix Bug 1: Use args.input (matching the --input argument name)\r\n    result = reconcile(args.input)\r\n    print(json.dumps(result))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
